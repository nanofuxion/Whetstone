<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A debugger can only attach to a process signed with this; Whetstone
         verifies JIT with task_for_pid, and targets keep working with the
         debuggers LinIniOS already knows (StikDebug, JitStreamer-EB). -->
    <key>get-task-allow</key><true/>
</dict>
</plist>
